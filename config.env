# --- Основные настройки твоего ядра ---
KERNEL_SOURCE=https://github.com/LiloDeveloper/android_kernel_samsung_mt6768_new
KERNEL_SOURCE_BRANCH=lineage-19.1
KERNEL_DEFCONFIG=a31_defconfig
TARGET_ARCH=arm64
KERNEL_FILE=Image.gz-dtb

# --- Настройки тулчейна (компилятора) ---
EXTRA_BUILD_COMMAND=CC=gcc CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi-
DISABLE_LTO=true

# --- Настройки KernelSU ---
USE_KERNELSU=true
KERNELSU_TAG=v0.9.5

# --- Дополнительные опции ---
USE_KPROBES=false
USE_OVERLAYFS=true
NEED_DTBO=false
MAKE_BOOT_IMAGE=false