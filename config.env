# --- Основные настройки вашего ядра ---
KERNEL_SOURCE=https://github.com/LiloDeveloper/android_kernel_samsung_mt6768_new
KERNEL_SOURCE_BRANCH=lineage-19.1
KERNEL_CONFIG=a31_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_ARCH=arm64

# --- КЛЮЧЕВЫЕ ИСПРАВЛЕНИЯ ---
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5             # Последняя версия, совместимая с вашим не-GKI ядром
KSU_HOOKS_PATCH=true            # Автоматически адаптирует исходники под KernelSU
ADD_OVERLAYFS_CONFIG=true       # Необходимо для поддержки модулей

# --- Отключение проблемной оптимизации ---
DISABLE_LTO=true