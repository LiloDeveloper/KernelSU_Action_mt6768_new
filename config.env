KERNEL_SOURCE=https://github.com/LiloDeveloper/android_kernel_samsung_mt6768_new
KERNEL_SOURCE_BRANCH=lineage-19.1
KERNEL_DEFCONFIG=a31_defconfig
TARGET_ARCH=arm64
KERNEL_FILE=Image.gz-dtb
EXTRA_BUILD_COMMAND=CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi-
DISABLE_LTO=true
USE_KERNELSU=true
KERNELSU_TAG=v0.9.5
USE_KPROBES=false
USE_OVERLAYFS=true
NEED_DTBO=false
MAKE_BOOT_IMAGE=false