# --- Основные настройки твоего ядра ---
KERNEL_SOURCE=https://github.com/LiloDeveloper/android_kernel_samsung_mt6768_new
KERNEL_SOURCE_BRANCH=lineage-19.1
KERNEL_CONFIG=a31_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_ARCH=arm64

# --- КЛЮЧЕВЫЕ ИСПРАВЛЕНИЯ ---
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5             # ФИКСИРУЕМ совместимую версию KernelSU (не 1.0!)
KSU_HOOKS_PATCH=true            # ВКЛЮЧАЕМ автоматическое исправление исходников для KernelSU (это заменит ручные правки)
ADD_OVERLAYFS_CONFIG=true       # Включаем поддержку модулей (нужно для будущих экспериментов)

# --- Настройки тулчейна (компилятора) ---
# Этот Action сам настроит GCC, нам нужно только указать отключить LTO
DISABLE_LTO=true